{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/route.schema.json",
  "title": "Procedural tunnel route",
  "type": "object",
  "required": ["tunnel_id", "alignment", "structural_archetype", "track"],
  "properties": {
    "tunnel_id": {"type": "string"},
    "structural_archetype": {"type": "string"},
    "alignment": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "track": {"type": "object"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["s_start", "s_end", "type"],
        "properties": {
          "s_start": {"type": "number"},
          "s_end": {"type": "number"},
          "type": {"type": "string"},
          "family_id": {"type": ["string", "null"]}
        }
      }
    }
  },
  "additionalProperties": true
}
